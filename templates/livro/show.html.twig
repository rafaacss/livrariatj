{% extends 'base.html.twig' %}

{% block title %}Livro{% endblock %}

{% block body %}
    <h1>Livro</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Codl</th>
                <td>{{ livro.Codl }}</td>
            </tr>
            <tr>
                <th>Titulo</th>
                <td>{{ livro.Titulo }}</td>
            </tr>
            <tr>
                <th>Editora</th>
                <td>{{ livro.Editora }}</td>
            </tr>
            <tr>
                <th>Edicao</th>
                <td>{{ livro.Edicao }}</td>
            </tr>
            <tr>
                <th>AnoPublicacao</th>
                <td>{{ livro.AnoPublicacao }}</td>
            </tr>
            <tr>
                <th>Valor</th>
                <td>{{ livro.Valor }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_livro_index') }}">back to list</a>

    <a href="{{ path('app_livro_edit', {'Codl': livro.Codl}) }}">edit</a>

    {{ include('livro/_delete_form.html.twig') }}
{% endblock %}

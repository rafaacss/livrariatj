<div class="container py-4">
   <div class="card shadow-sm mx-auto">
        <div class="card-header">
            <h1 class="h4 mb-0">
                {{ title|default('Livro') }}
            </h1>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
            <div class="row g-3">
                <div class="col-md-6">
                    {{ form_row(form.Titulo) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.Editora) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.Edicao) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.AnoPublicacao) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.Valor) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.autores) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.assuntos) }}
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a
                    href="{{ path('app_livro_index') }}"
                    class="btn btn-secondary"
                >
                    Cancelar
                </a>

                <button class="btn btn-primary">
                    {{ button_label|default('Salvar') }}
                </button>
            </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>
{% block javascripts %}
    <script type="text/javascript">
        const form = document.querySelector('form');
        const valorInput = document.querySelector('#livro_Valor');

        document.addEventListener('DOMContentLoaded', function () {
            if (valorInput.value) {
                const valorInicial = valorInput.value.replace(',', '.');

                if (!isNaN(Number(valorInicial))) {
                    valorInput.value = Number(valorInicial).toLocaleString('pt-BR', {
                        style: 'currency',
                        currency: 'BRL'
                    });
                }
            }
        })

        valorInput.addEventListener('input', function(event) {
            let valor = this.value.replace(/[^0-9]/g, '');

            if (!form || !valor) {
                this.value = '';
                return;
            }

            valor = (parseInt(valor) / 100).toFixed(2);

            this.value = new Intl.NumberFormat(
                'pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                }
            ).format(valor);
        })
        form.addEventListener('submit', () => {
            let valor = valorInput.value;

            valor = valorInput.value
                .replace(/\s/g, '')
                .replace('R$', '')
                .replace(/\./g, '')
                .replace(',', '.');

            valorInput.value = valor;
        });
    </script>
{% endblock %}

<form method="post" action="{{ path('app_livro_delete', {'Codl': livro.Codl}) }}" onsubmit="return confirm('Tem certeza que deseja excluir o livro {{ livro.titulo }}?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ livro.Codl) }}">
    <button class="btn btn-sm btn-danger form-control">Excluir</button>
</form>
<style>
    form {
        margin-bottom: 0 !important;
    }
</style>

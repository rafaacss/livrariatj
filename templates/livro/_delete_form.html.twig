<form class="" method="post" action="{{ path('app_livro_delete', {'Codl': livro.Codl}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ livro.Codl) }}">
    <button class="btn btn-sm btn-danger">Excluir</button>
</form>

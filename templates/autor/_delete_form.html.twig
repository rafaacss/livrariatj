<form method="post" action="{{ path('app_autor_delete', {'CodAu': autor.CodAu}) }}" onsubmit="return confirm('Tem certeza que deseja excluir o autor {{ autor.nome }}?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ autor.CodAu) }}">
    <button class="btn btn-sm btn-danger form-control">Excluir</button>
</form>
<style>
    form {
        margin-bottom: 0 !important;
    }
</style>

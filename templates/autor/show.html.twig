{% extends 'base.html.twig' %}

{% block title %}Autor{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="card shadow-sm mx-auto" >
        <div class="card-header">
            <h1 class="h4 mb-0">
                Autor
            </h1>
        </div>
        <div class="card-body">
            <table class="table table-bordered align-middle mb-0">
                <tbody>
                    <tr>
                        <th class="table-light" style="width: 30%;">
                            Código
                        </th>
                        <td>
                            {{ autor.CodAu }}
                        </td>
                    </tr>

                    <tr>
                        <th class="table-light">
                            Nome
                        </th>
                        <td>
                            {{ autor.Nome }}
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="card-footer d-flex justify-content-between align-items-center">
                <a
                    href="{{ path('app_autor_index') }}"
                    class="btn btn-secondary"
                >
                    Voltar
                </a>

                <div class="justify-content-between align-items-center d-flex gap-2">
                    <a
                        href="{{ path('app_autor_edit', {'CodAu': autor.CodAu}) }}"
                        class="btn btn-primary"
                    >
                        Editar
                    </a>

                    {{ include('autor/_delete_form.html.twig') }}

                </div>
            </div>
    </div>
</div>
{% endblock %}

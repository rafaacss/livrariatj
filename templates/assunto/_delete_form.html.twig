<form method="post" action="{{ path('app_assunto_delete', {'codAs': assunto.codAs}) }}" onsubmit="return confirm('tem certeza que deseja excluir {{ assunto.descricao }}?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assunto.codAs) }}">
    <button class="btn btn-sm btn-danger form-control">Excluir</button>
</form>
<style>
    form {
        margin-bottom: 0 !important;
    }
</style>

{% extends 'base.html.twig' %}

{% block title %}Assuntos{% endblock %}

{% block body %}

    <div class="container py-4">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">

                <h1 class="h4 mb-0">
                    Assuntos
                </h1>

                <a
                    href="{{ path('app_assunto_new') }}"
                    class="btn btn-primary"
                >
                    Novo assunto
                </a>

            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Descrição</th>
                            <th class="text-center">Ações</th>
                        </tr>
                        </thead>

                        <tbody>

                        {% for assunto in assuntos %}
                            <tr>
                                <td>
                                    {{ assunto.codAS }}
                                </td>
                                <td>
                                    <strong>
                                        {{ assunto.descricao }}
                                    </strong>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-1">
                                        <a
                                            href="{{ path('app_assunto_show', {'codAs': assunto.codAs}) }}"
                                            class="btn btn-secondary"
                                        >
                                            Visualizar
                                        </a>

                                        <a
                                            href="{{ path('app_assunto_edit', {'codAs': assunto.codAs}) }}"
                                            class="btn btn-primary"
                                        >
                                            Editar
                                        </a>

                                        {{ include('assunto/_delete_form.html.twig', {'assunto': assunto}) }}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td
                                    colspan="7"
                                    class="text-center text-muted py-4"
                                >
                                    Nenhum assunto encontrado.
                                </td>
                            </tr>

                        {% endfor %}

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
